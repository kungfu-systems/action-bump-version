{
  "name": "@kungfu-systems/action-bump-version",
  "version": "4.0.3-alpha.0",
  "type": "module",
  "main": "dist/index.js",
  "repository": "https://github.com/kungfu-systems/action-bump-version",
  "author": "Keren Dong",
  "license": "Apache-2.0",
  "scripts": {
    "build": "yarn lint && yarn format:check && yarn dist",
    "dist": "ncc build index.js && perl -pi -e 's/[[:blank:]]+$//' dist/index.js",
    "package": "echo noop",
    "format": "prettier --write --parser typescript \"*.js\"",
    "format:check": "prettier --check --parser typescript \"*.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "git-client": "^1.12.1",
    "semver": "^7.8.5",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.1",
    "@vercel/ncc": "^0.44.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.0"
  }
}
